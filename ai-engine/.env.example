# ─────────────────────────────────────────────────────────────────────────────
# AI Engine environment template — copy to .env and fill in real values:
#   cd ai-engine && cp .env.example .env
#
# This file lists the variables THIS SERVICE reads (every one of them is an
# os.getenv() call somewhere under src/). The repository root also has an
# .env.example: that one configures docker-compose, so it additionally carries
# POSTGRES_PASSWORD and the frontend's EIP_* variables, and compose injects the
# values below into the container itself. Use this file when you run uvicorn
# directly; use the root one when you run `docker compose up`. Never commit the
# resulting .env — ai-engine/.gitignore excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# Where the engine persists everything. SQLite is for local development only;
# staging and production must point at PostgreSQL.
#   Production: postgresql://user:pass@host:5432/eip_db
DATABASE_URL=sqlite:///database.db

# Zero Trust internal key shared between the frontend proxy and this engine.
# Every router requires it; without a value the engine answers 500 by design.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-internal-key

# JWT signing secret (HS256). No hardcoded fallback exists: when this is unset
# the engine mints a random ephemeral secret, so every restart invalidates all
# outstanding tokens. Production MUST set it explicitly.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-jwt-secret

# Google Gemini API key (https://aistudio.google.com/apikey). Extraction is the
# only feature that needs it; the rest of the API runs without one.
GEMINI_API_KEY=

# true turns on SQL echo. Keep it false anywhere real data lives — echoed
# queries put candidate evidence into the log stream.
DEBUG=false

# Public address of the web frontend. Password-reset links are built from it,
# so a wrong value mails users a link into nowhere.
FRONTEND_URL=http://localhost:3000

# ── Transactional e-mail (Resend) ────────────────────────────────────────────
# Without RESEND_API_KEY nothing is sent: the engine records that it skipped
# delivery and every flow still completes, which is why local development needs
# no mail account. EMAIL_FROM must be a domain verified at the provider.
RESEND_API_KEY=
EMAIL_FROM=EIP <onboarding@resend.dev>

# ── Error tracking (Sentry) ──────────────────────────────────────────────────
# Empty = completely dormant; the SDK is installed but never initialised.
# PII forwarding stays off regardless (send_default_pii=False).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Optional overrides (defaults in parentheses) ─────────────────────────────
# LLM_PROVIDER=gemini            # gemini (default) | openai | anthropic
# LLM_MODEL_NAME=gemini-flash-latest
# MAX_UPLOAD_BYTES=5242880       # 5 MB upload ceiling
# UPLOAD_DIR=                    # (ai-engine/uploads) moderated document store
