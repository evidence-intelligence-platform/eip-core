# ─────────────────────────────────────────────────────────────────────────────
# EIP environment template — copy to .env and fill in real values.
# NEVER commit the real .env. All values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=change-me-strong-db-password

# Zero Trust internal key shared between the frontend proxy and the AI Engine.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-internal-key

# JWT signing secret (HS256). The engine refuses guessable defaults.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-jwt-secret

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# LLM_MODEL_NAME=gemini-2.5-flash
# DATABASE_URL=sqlite:///database.db   # local dev without Docker
# DEBUG=false

# Frontend (only needed when running `next` outside docker-compose)
# EIP_API_URL=http://127.0.0.1:8080
# EIP_INTERNAL_API_KEY=<same as INTERNAL_API_KEY>
