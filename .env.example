# ─────────────────────────────────────────────────────────────────────────────
# EIP environment template — copy to .env and fill in real values.
# NEVER commit the real .env. All values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=change-me-strong-db-password

# Zero Trust internal key shared between the frontend proxy and the AI Engine.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-internal-key

# JWT signing secret (HS256). The engine refuses guessable defaults.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-jwt-secret

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# LLM_MODEL_NAME=gemini-flash-latest
# LLM_PROVIDER=gemini   # gemini (varsayilan) | openai_compat — openai ve anthropic henuz eklenmedi
# DATABASE_URL=sqlite:///database.db   # local dev without Docker
# DEBUG=false

# openai_compat provider (any OpenAI-wire-format endpoint: NVIDIA NIM, Groq,
# OpenRouter, ...). Set LLM_PROVIDER=openai_compat above to use these instead
# of Gemini — see ai-engine/.env.example for the full explanation.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_COMPAT_MODEL_NAME=meta/muse-glimmer-30b

# Transactional e-mail (Resend). Without the key, no e-mail is sent — the
# engine only logs that delivery was skipped, never the reset link or the
# message body. To see the reset link in the engine log during development,
# set EMAIL_DEV_LOG_LINK=true — LOCAL ONLY: the link is a live single-use
# reset token, so in any shared environment log access equals account takeover.
# RESEND_API_KEY=
# EMAIL_FROM=EIP <onboarding@resend.dev>   # set after domain verification
# EMAIL_DEV_LOG_LINK=false                 # true only on your own machine

# Where password-reset links point (the public site address in production).
# FRONTEND_URL=http://localhost:3000

# Error tracking (Sentry). Empty = completely disabled.
# SENTRY_DSN=                      # backend + frontend server-side
# NEXT_PUBLIC_SENTRY_DSN=          # frontend browser-side (build-time inlined)

# Frontend (only needed when running `next` outside docker-compose)
# EIP_API_URL=http://127.0.0.1:8080
# EIP_INTERNAL_API_KEY=<same as INTERNAL_API_KEY>
